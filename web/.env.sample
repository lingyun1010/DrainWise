# Copy this file to web/.env.local and fill in the blanks. .env.local is gitignored; never commit it,
# and never paste these values into chat, issues or PRs.

# --- Crew photo storage (ticket 16): the DrainWise Supabase project --------------------------------
# Project URL. Not a secret.
SUPABASE_URL=https://agbaveozfhsxqywkjdiw.supabase.co
# SECRET. Supabase dashboard > Project Settings > API > service_role. Server-only: this has no
# NEXT_PUBLIC_ prefix on purpose, so it is never sent to the browser. Do not put it in client code.
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 to save crew photos to Supabase. Leave it out to keep photos in memory only.
NEXT_PUBLIC_PHOTO_UPLOAD=1

# --- Chatbot (ticket 31): Claude API, the only real AI call in the app ----------------------------
# SECRET. Anthropic console > API keys. Set a spend limit there. Server-only (no NEXT_PUBLIC_ prefix). Leave empty and
# the chat panel says "not set up". Never paste it into chat, issues or PRs.
ANTHROPIC_API_KEY=
# Optional. Default is claude-haiku-5-5.
# CHAT_MODEL=claude-haiku-5-5
# Kill switch: set to 1 and /api/chat answers "chat is off" at once.
# CHAT_DISABLED=1

# --- Vercel only (set in the Vercel project settings, not here) ----------------------------------
# NEXT_PUBLIC_PUBLIC_BUILD=1       public demo build
# NEXT_PUBLIC_PHOTO_UPLOAD=1       allow uploads on the public demo (24 hour expiry)
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY   same as above
# ANTHROPIC_API_KEY, CHAT_DISABLED   chat on the public demo (set a spend limit in the Anthropic console)
# CRON_SECRET=<any long random string>      lets the daily clean-up route run

# --- Risk report email (ticket 23): Gmail SMTP from the owner's account ---------------------------
# Leave these empty and /api/send-report answers 503 ("not set up"); Preview still works.
# Your Gmail address (the "from" address).
GMAIL_USER=
# SECRET. A Google "app password" (Google Account > Security > 2-step verification > App passwords), not your
# normal password. Server-only (no NEXT_PUBLIC_ prefix). Never paste it into chat, issues or PRs.
GMAIL_APP_PASSWORD=
# SECRET. Any long random string. Required to send: the /report page asks for it and sends it as the x-report-key header.
# Without it anybody who finds /report could send mail from your Gmail.
REPORT_ADMIN_KEY=
# Kill switch: set to 1 and /api/send-report answers 503 at once, with no redeploy of code.
REPORT_EMAIL_OFF=
# Local tests only (ignored in production builds): 1 runs the whole send flow without sending anything. Admin key is then "mock".
# REPORT_EMAIL_MOCK=1
